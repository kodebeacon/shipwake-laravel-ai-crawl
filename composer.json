  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/kodebeacon/shipwake-laravel-ai-crawl",
  "keywords": [
    "shipwake",
    "laravel",
    "analytics",
    "ai",
    "crawler",
    "observability"
  ],
  "support": {
